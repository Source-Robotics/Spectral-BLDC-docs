          "direction": "host",
          "length": 8,
          "remote": false,
          "title": "position setpoint with speed and current feedforward (position mode)",
          "fields": [
            {
              "name": "Position setpoint",
              "byte": 0,
              "size": 3,
              "bits": null,
              "width": 24,
              "signed": true,
              "float": false,
              "lsb_first": false,
              "meaning": "encoder ticks"
            },
            {
              "name": "Speed feedforward",
