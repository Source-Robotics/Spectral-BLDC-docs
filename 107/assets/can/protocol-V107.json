              "width": 32,
              "signed": false,
              "float": false,
              "lsb_first": false,
              "meaning": "ms; 0 = off"
            }
          ]
        }
      ]
    },
    {
      "key": "IN_SETTINGS",
      "id": 35,
      "name": "Send_Settings",
      "description": "Sets boolean settings that have no command of their own: a mask byte says which settings the frame touches, a value byte gives their new values; settings outside the mask are left alone. Bit 0 is the idle behaviour: 1 brake (phases shorted), 0 coast. Added in firmware 107 (STEPFOC 108). The Python library has no call for it yet.",
      "forms": [
        {
          "direction": "host",
          "length": 2,
          "remote": false,
          "title": "command",
          "fields": [
            {
              "name": "Mask",
              "byte": 0,
              "size": 1,
              "bits": null,
              "width": 8,
              "signed": false,
              "float": false,
              "lsb_first": false,
              "meaning": "bit 0 = write the idle behaviour"
            },
            {
              "name": "Value",
              "byte": 1,
              "size": 1,
              "bits": null,
              "width": 8,
              "signed": false,
              "float": false,
              "lsb_first": false,
              "meaning": "bit 0: 1 brake, 0 coast"
            }
          ]
        }
      ]
    },
    {
      "key": "IN_GRIPPER_DATA_PACK",
      "id": 61,
      "name": "Send_gripper_data_pack",
      "description": "The gripper command, for a driver set up as a gripper (`#Gripper 1`, saved). Position, speed and the current limit of the move, plus the activate, action and E-stop bits. A move is carried out only while the gripper is calibrated, activated and the action bit is 1. An empty frame (0 bytes) only asks for the state.",
      "forms": [
        {
          "direction": "host",
          "length": 5,
          "remote": false,
          "title": "command",
          "fields": [
            {
              "name": "Position",
              "byte": 0,
              "size": 1,
              "bits": null,
              "width": 8,
              "signed": false,
              "float": false,
              "lsb_first": false,
              "meaning": "0 fully open, 255 fully closed"
            },
            {
              "name": "Speed",
              "byte": 1,
              "size": 1,
              "bits": null,
              "width": 8,
              "signed": false,
              "float": false,
              "lsb_first": false,
              "meaning": "0 slowest, 255 fastest"
            },
            {
              "name": "Current",
              "byte": 2,
              "size": 2,
              "bits": null,
              "width": 16,
              "signed": true,
              "float": false,
              "lsb_first": false,
              "meaning": "current limit of the move in mA; not clamped by the firmware, see the gripper manual for the safe range"
            },
            {
              "name": "Activate",
              "byte": 4,
              "size": 1,
              "bits": [
                7
              ],
              "width": 1,
              "signed": false,
              "float": false,
              "lsb_first": false,
              "meaning": "1 activate the gripper, 0 deactivate"
            },
            {
              "name": "Action",
              "byte": 4,
              "size": 1,
              "bits": [
                6
              ],
              "width": 1,
              "signed": false,
              "float": false,
              "lsb_first": false,
              "meaning": "1 go to the position, 0 idle"
            },
            {
              "name": "E-stop",
              "byte": 4,
              "size": 1,
              "bits": [
                5
              ],
              "width": 1,
              "signed": false,
              "float": false,
              "lsb_first": false,
              "meaning": "1 raises the gripper E-stop error"
            },
            {
              "name": "Release direction",
              "byte": 4,
              "size": 1,
              "bits": [
                4
              ],
              "width": 1,
              "signed": false,
              "float": false,
              "lsb_first": false,
              "meaning": "read by the firmware but not used"
            }
          ]
        },
        {
          "direction": "host",
          "length": 0,
          "remote": false,
          "title": "status poll",
          "fields": []
        }
